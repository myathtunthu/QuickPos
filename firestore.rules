rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return signedIn() && exists(/databases/$(database)/documents/pos_users/$(request.auth.uid));
    }

    function myUser() {
      return get(/databases/$(database)/documents/pos_users/$(request.auth.uid)).data;
    }

    function myTenantId() {
      return myUser().tenantId;
    }

    function myRole() {
      return myUser().role;
    }

    function isSuperAdmin() {
      return userDocExists() && (myRole() == 'superadmin' || myRole() == 'super_admin');
    }

    function isActive() {
      return userDocExists()
        && (
          isSuperAdmin()
          || myUser().status == 'active'
          || myUser().active == true
          || !('status' in myUser())
        )
        && myUser().status != 'blocked';
    }

    function isAdmin() {
      return isActive()
        && (myRole() == 'admin' || myRole() == 'owner');
    }

    function sameTenant(tenantId) {
      return isActive() && myTenantId() == tenantId;
    }

    function hasPermission(permission) {
      return isSuperAdmin()
        || isAdmin()
        || (isActive() && permission in myUser().permissions);
    }

    function hasNoStoredPassword() {
      return !('password' in request.resource.data)
        && !('passwordRaw' in request.resource.data)
        && !('plainPassword' in request.resource.data);
    }

    function hasNoStoredPasswordUnlessSuperAdmin() {
      return isSuperAdmin() || hasNoStoredPassword();
    }

    function isStockOnlyProductUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['stock', 'stockBase', 'updatedAt', 'updatedAtServer']);
    }

    function canCreateSaleOrPurchase() {
      return hasPermission('create_sale') || hasPermission('create_purchase');
    }

    function isCustomerPaymentRecord() {
      return request.resource.data.type == 'Customer Payment'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.customerId is string
        && request.resource.data.personName is string;
    }

    function isSupplierPaymentRecord() {
      return request.resource.data.type == 'Supplier Payment'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.supplierId is string
        && request.resource.data.personName is string;
    }

    function isDebtOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['totalDebt', 'updatedAt', 'updatedAtServer']);
    }

    match /pos_users/{userId} {
      allow read: if isSuperAdmin()
        || (isActive() && request.auth.uid == userId)
        || (isAdmin() && resource.data.tenantId == myTenantId());

      allow create: if (isSuperAdmin() || isAdmin())
        && hasNoStoredPasswordUnlessSuperAdmin()
        && (
          isSuperAdmin()
          || request.resource.data.tenantId == myTenantId()
        );

      allow update: if (isSuperAdmin()
          || (isAdmin() && resource.data.tenantId == myTenantId()))
        && request.resource.data.tenantId == resource.data.tenantId
        && hasNoStoredPasswordUnlessSuperAdmin();

      allow delete: if isSuperAdmin();
    }

    match /pos_products/{docId} {
      allow read: if isSuperAdmin() || sameTenant(resource.data.tenantId);
      allow create: if sameTenant(request.resource.data.tenantId) && hasPermission('manage_products');
      allow update: if sameTenant(resource.data.tenantId)
        && (
          hasPermission('manage_products')
          || (canCreateSaleOrPurchase() && isStockOnlyProductUpdate())
        );
      allow delete: if isAdmin() && resource.data.tenantId == myTenantId();
    }

    match /pos_records/{docId} {
      allow read: if isSuperAdmin()
        || (
          sameTenant(resource.data.tenantId)
          && (
            hasPermission('view_sales')
            || hasPermission('view_reports')
            || (
              hasPermission('create_purchase')
              && (resource.data.type == 'Supplier Payment' || resource.data.type == 'Purchase')
            )
            || (
              hasPermission('accept_payment')
              && resource.data.type == 'Customer Payment'
            )
          )
        );
      allow create: if sameTenant(request.resource.data.tenantId)
        && (
          hasPermission('create_sale')
          || hasPermission('create_purchase')
          || hasPermission('create_expense')
          || (hasPermission('accept_payment') && isCustomerPaymentRecord())
          || (hasPermission('create_purchase') && isSupplierPaymentRecord())
        );
      allow update: if sameTenant(resource.data.tenantId) && hasPermission('delete_records');
      allow delete: if isAdmin() && resource.data.tenantId == myTenantId();
    }

    match /pos_customers/{docId} {
      allow read: if isSuperAdmin()
        || (
          sameTenant(resource.data.tenantId)
          && (
            hasPermission('view_customers')
            || hasPermission('manage_customers')
            || hasPermission('create_sale')
            || hasPermission('accept_payment')
          )
        );
      allow create: if sameTenant(request.resource.data.tenantId)
        && (hasPermission('manage_customers') || hasPermission('create_sale'));
      allow update: if sameTenant(resource.data.tenantId)
        && (
          hasPermission('manage_customers')
          || (hasPermission('create_sale') && isDebtOnlyUpdate())
          || (hasPermission('accept_payment') && isDebtOnlyUpdate())
        );
      allow delete: if isAdmin() && resource.data.tenantId == myTenantId();
    }

    match /pos_suppliers/{docId} {
      allow read: if isSuperAdmin()
        || (
          sameTenant(resource.data.tenantId)
          && (
            hasPermission('view_suppliers')
            || hasPermission('manage_suppliers')
            || hasPermission('create_purchase')
          )
        );
      allow create: if sameTenant(request.resource.data.tenantId)
        && (hasPermission('manage_suppliers') || hasPermission('create_purchase'));
      allow update: if sameTenant(resource.data.tenantId)
        && (
          hasPermission('manage_suppliers')
          || (hasPermission('create_purchase') && isDebtOnlyUpdate())
        );
      allow delete: if isAdmin() && resource.data.tenantId == myTenantId();
    }

    match /pos_settings/{docId} {
      allow read: if isSuperAdmin() || sameTenant(resource.data.tenantId) || (isActive() && docId == myTenantId());
      allow create: if (isSuperAdmin() || sameTenant(request.resource.data.tenantId)) && hasPermission('settings');
      allow update: if (isSuperAdmin() || sameTenant(resource.data.tenantId)) && hasPermission('settings');
      allow delete: if isSuperAdmin() || (isAdmin() && resource.data.tenantId == myTenantId());
    }

    match /pos_drafts/{docId} {
      allow read: if isSuperAdmin() || (sameTenant(resource.data.tenantId) && canCreateSaleOrPurchase());
      allow create: if sameTenant(request.resource.data.tenantId) && canCreateSaleOrPurchase();
      allow update, delete: if sameTenant(resource.data.tenantId) && canCreateSaleOrPurchase();
    }

    match /audit_logs/{docId} {
      allow read: if isSuperAdmin() || isAdmin();
      allow create: if isActive();
      allow update, delete: if false;
    }

    match /tenant_compliance_reviews/{docId} {
      allow read, create, update: if isSuperAdmin();
      allow delete: if false;
    }


    match /tenant_backups/{docId} {
      allow read: if isSuperAdmin() || (isAdmin() && resource.data.tenantId == myTenantId());
      allow create, update, delete: if false;
    }

    match /tenant_restore_jobs/{docId} {
      allow read: if isSuperAdmin() || (isAdmin() && resource.data.tenantId == myTenantId());
      allow create, update, delete: if false;
    }

    match /admin_sessions/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
